# C2-Dploy — variables d'environnement (copier vers .env, non committé)
# Usage :
#   cp .env.example .env
#   # éditer .env avec vos valeurs
#   set -a && source .env && set +a
#   make deploy

# Mot de passe admin pour tous les C2 (Havoc, Mythic, Empire, Metasploit RPC).
# OBLIGATOIRE. Minimum 12 caractères.
export TF_VAR_default_password="changez-moi-par-un-mdp-fort"

# Token API DigitalOcean (uniquement si deploy_on_digitalocean=true).
# export DIGITALOCEAN_TOKEN="dop_v1_..."
